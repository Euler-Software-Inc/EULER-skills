#!/bin/sh
# EULER-skills pre-push hook — runs the quality gate; blocks the push on failure.
# Activate once per clone:  git config core.hooksPath .githooks
echo "→ Running quality gate before push (node scripts/quality-gate.mjs)…"
if ! node scripts/quality-gate.mjs; then
  echo ""
  echo "✗ Push aborted: quality gate failed. Fix the errors above."
  echo "  (To bypass in an emergency: git push --no-verify — not recommended.)"
  exit 1
fi
